# Copie este arquivo para ".env" e preencha os valores.
# O arquivo .env NUNCA deve ir para o Git.

# Chave da API da Riot (https://developer.riotgames.com). A de desenvolvimento expira a cada 24h.
RIOT_API_KEY=RGAPI-coloque-sua-chave-aqui

# Postgres local (usado pelo docker-compose.yml e pelo back-end)
POSTGRES_USER=lolstats
POSTGRES_PASSWORD=lolstats
POSTGRES_DB=lolstats
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lolstats:lolstats@localhost:5432/lolstats

# Tempo mínimo (minutos) antes de consultar a Riot de novo para o mesmo jogador
CACHE_TTL_MINUTES=10

# Intervalo mínimo (segundos) entre dois "Atualizar" forçados do mesmo jogador
REFRESH_COOLDOWN_SECONDS=120

# Origens (front-end) autorizadas a chamar a API, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Partidas buscadas em segundo plano por jogador para o painel de insights (0 desliga)
HISTORICO_PARTIDAS=100
